{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "milesueee-nagomi",
  "compatibility_date": "2026-09-11",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
